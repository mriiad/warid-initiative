# Copy this file to .env and fill in real values for your environment.
# Every variable has a working default in src/utils/config.js, so the app
# boots without a .env at all -- but don't rely on the defaults past local
# development (they're only meant to be predictable placeholders, not secure).

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Frontend (used for CORS and links embedded in emails) ---
FRONTEND_URL=http://localhost:4200
FRONTEND_PROTOCOL=http
FRONTEND_HOST=localhost
FRONTEND_PORT=4200

# --- Database (MongoDB Atlas) ---
DB_HOST=mongodb+srv
DB_NAME=warid
DB_USER=
DB_PASSWORD=
DB_SAMPLE=

# --- Auth (required) ---
# The server refuses to start unless both of these are set to a real random
# value -- generate one with `openssl rand -base64 32`. They have no
# fallback on purpose: they used to default to constants written into
# src/utils/config.js, so a deployment that forgot them signed every token
# with a value anyone could read in this repository. See issue #394.
# JWT_SECRET_KEY signs/verifies every login/session token (auth.js and
# token-check.js both read this same value).
JWT_SECRET_KEY=
# REFRESH_SECRET_KEY does the same for refresh tokens.
REFRESH_SECRET_KEY=
JWT_EXPIRE=1d
REFRESH_TOKEN_EXPIRE=7d
PASSWORD_RESET_EXPIRE_MINUTES=15
ACTIVATION_LINK_EXPIRE_HOURS=24

# --- Logging ---
# Output is line-delimited JSON. Pipe it through `npx pino-pretty` for
# readable local output. Levels: fatal, error, warn, info, debug, trace,
# silent. Defaults to info, and to silent under NODE_ENV=test.
LOG_LEVEL=info

# --- Proxy ---
# Number of reverse proxies in front of the app. Express needs this to read
# the real client IP from X-Forwarded-For, which the rate limiter keys off.
# Leave unset when the app is exposed directly: trusting the header when
# nothing sets it lets a caller spoof their IP and bypass the limits.
# TRUST_PROXY_HOPS=1

# --- Rate limiting (per IP, on the public endpoints) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_MAIL_MAX=5
RATE_LIMIT_PUBLIC_WRITE_MAX=20

# --- Security headers ---
# HSTS is only meaningful over TLS. Enabling it while the deployment still
# answers on plain HTTP pins browsers to a scheme the server doesn't serve,
# for a year. Turn on once TLS is terminated in front.
HSTS_ENABLED=false

# --- Email (contact form + password reset + activation emails) ---
EMAIL_ENABLED=true
EMAIL_FROM=do-not-reply@warid.ma
# Where contact-form submissions are delivered.
CONTACT_EMAIL=team@warid.ma
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_CIPHERS=SSLv3
SMTP_REQUIRE_TLS=false
