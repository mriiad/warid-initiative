  "faq": {
    "title": "Frequently Asked Questions",
    "question1": "Who is allowed to donate blood?",
    "answer1": "Healthy adults aged between 18 and 60, weighing at least 50 kg and in good health are eligible to donate blood.",
    "question2": "Who is not allowed to donate blood?",
    "answer2": "Those with chronic or infectious diseases, or who do not meet age and weight requirements, are not allowed to donate.",
    "question3": "How often can you donate blood?",
    "answer3": "Men can donate every 2 months, and women every 3 months.",
    "question4": "Is blood donation safe?",
    "answer4": "Yes, single-use sterile equipment is used, and donors undergo a medical check beforehand.",
    "question5": "Is the blood tested?",
    "answer5": "Yes, all blood is tested for infectious diseases.",
    "question6": "What are the benefits of donating?",
    "answer6": "It saves lives, stimulates blood circulation, and reduces excess iron in the body.",
    "question7": "Do you need to fast before donating?",
    "answer7": "No, it is recommended to eat a light meal and drink water before donating.",
    "question8": "What temporary conditions prevent donation?",
    "answer8": "After vaccination, tooth extraction, or recovery from illness, a waiting period is required.",
    "question9": "Can women donate blood?",
    "answer9": "Yes, provided they meet the age, health, and weight requirements.",
    "question10": "How is the donated blood used?",
    "answer10": "It is used in surgeries, emergencies, and treatment of chronic diseases.",
    "appQuestion1": "What is Warid?",
    "appAnswer1": "Warid is a digital platform that facilitates and organizes blood donation in Morocco by connecting donors to centers and patients.",
    "appQuestion2": "Is registration free?",
    "appAnswer2": "Yes, registration is completely free and open to everyone.",
    "appQuestion3": "Can I donate blood outside of campaigns?",
    "appAnswer3": "Yes, you can check the nearest donation center and go anytime.",
    "appQuestion4": "Can NGOs or hospitals register?",
    "appAnswer4": "Yes, there is a special section for partners to manage requests and organize donation events.",
    "appQuestion5": "Is my personal data protected?",
    "appAnswer5": "Yes, we strictly protect your privacy and never share your data without your consent."
  },
